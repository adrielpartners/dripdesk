{
  "name": "@dripdesk/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "node --experimental-test-coverage --test --require ts-node/register src/common/guards/roles.guard.test.ts src/modules/enrollments/enrollments.repository.test.ts src/modules/webhooks/webhooks.service.test.ts src/modules/webhooks/subscriber-intake.service.test.ts src/modules/billing/billing.service.test.ts src/modules/tracking/tracking.service.test.ts src/modules/campaigns/campaigns.service.test.ts src/modules/campaigns/campaigns.dto.test.ts src/modules/persons/persons.service.test.ts src/modules/auth/session-revocation.test.ts src/modules/provider-credentials/provider-credentials.service.test.ts src/modules/queue/queue.service.test.ts",
    "test:e2e": "node --test --require ts-node/register test/api-e2e.test.ts"
  },
  "dependencies": {
    "@dripdesk/config": "workspace:*",
    "@dripdesk/database": "workspace:*",
    "@dripdesk/shared": "workspace:*",
    "@getbrevo/brevo": "^5.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.4.2",
    "nanoid": "^3.3.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2"
  }
}
